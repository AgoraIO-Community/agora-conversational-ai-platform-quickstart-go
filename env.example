APP_ENV=development
AUTH_MODE=bypass
APP_PUBLIC_URL=http://localhost:3000

AGORA_APP_ID=
# Signs v3 API requests (the SDK generates a ConvoAI token per call).
AGORA_APP_CERTIFICATE=
# Optional: Console credentials enable the project picker (list/create/switch).
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# v3 API origin used by the Agora Agents SDK; omit for https://preview.ai.agora.io.
AGORA_AGENTS_V3_BASE_URL=
# Console projects API (/dev/v1), not covered by the SDK.
AGORA_STUDIO_API_BASE=https://api.agora.io
AGORA_STUDIO_DEBUG=false

# Required only when AUTH_MODE=sso.
SESSION_JWT_SECRET=
AGORA_SSO_CLIENT_ID=
AGORA_SSO_CLIENT_SECRET=
AGORA_SSO_REDIRECT_URI=http://localhost:3000/api/auth/agora/callback
AGORA_SSO_BASE_URL=https://sso2.agora.io
AGORA_SSO_OPEN_API_BASE=https://sso-open.agora.io/api-docs/v1

